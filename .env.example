# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/ai_assistant

# Google AI Studio API key — used with Gemini 2.5 Flash (https://aistudio.google.com)
AI_API_KEY=

# OpenWeatherMap API key — used by the get_weather tool (https://openweathermap.org/api)
WEATHER_API_KEY=

# Secret used by BetterAuth to sign sessions — must be at least 32 characters (e.g. openssl rand -base64 32)
BETTERAUTH_SECRET=

# Port the API server listens on (default: 3000)
PORT=3000

# Public base URL of the API — used by BetterAuth to build session URLs (default: http://localhost:3000)
# In production set this to your deployed API URL (e.g. https://your-api.railway.app)
API_URL=http://localhost:3000

# Allowed frontend origin for CORS (default: http://localhost:3001)
# In production set this to your deployed frontend URL (e.g. https://your-app.vercel.app)
WEB_URL=http://localhost:3001

# Backend base URL consumed by the frontend — must be a Vite BUILD-time variable on Vercel
# In production set this to your deployed API URL (e.g. https://your-api.railway.app)
VITE_API_URL=http://localhost:3000
