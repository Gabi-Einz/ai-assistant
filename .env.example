# MongoDB connection string (e.g. mongodb://localhost:27017/ai-assistant)
MONGODB_URI=

# API key for the AI provider (Anthropic, OpenAI, etc.) used by AI SDK
AI_API_KEY=

# API key for the weather provider (e.g. OpenWeatherMap)
WEATHER_API_KEY=

# Secret used by BetterAuth to sign sessions — must be long and random
BETTERAUTH_SECRET=

# Port the API server listens on (default: 3000)
PORT=3000

# Backend base URL consumed by the frontend tRPC client (configured in step 10)
VITE_API_URL=http://localhost:3000
